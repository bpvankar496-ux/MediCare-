# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospital?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT auth tokens - set this to a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional - enables the AI-powered Symptom Checker.
# Get a key at https://console.anthropic.com. Without this set, the
# symptom checker still works using its static/offline symptom database.
ANTHROPIC_API_KEY=
# Optional - override the model used for AI symptom analysis.
ANTHROPIC_MODEL=claude-sonnet-4-5
