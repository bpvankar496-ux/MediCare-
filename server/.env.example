# Copy to server/.env and fill in your own values. Never commit the real
# .env file (it's already in .gitignore).

MONGODB_URI=
JWT_SECRET=
PORT=4000
CLIENT_ORIGIN=
RECEPTION_EMAIL=
RECEPTION_PASSWORD=
RECEPTION_NAME=
GOOGLE_CLIENT_ID=
GROQ_API_KEY=
ANTHROPIC_MODEL=
# --- Blockchain (Ethereum Sepolia testnet) ---
# Leave these blank to run the app without blockchain features - everything
# else keeps working. Fill them in after deploying the contract in /blockchain
# (see blockchain/README.md) to enable real on-chain anchoring/verification
# of health records.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=
# --- IPFS file storage (optional, needs the blockchain vars above too) ---
# Lets health records store the actual attached file on IPFS (via Pinata's
# free-tier pinning API), with the resulting CID anchored on-chain alongside
# the record's hash - not just a hash of the file, but a permanent,
# independently-fetchable copy of it. Get a JWT key at
# https://app.pinata.cloud (Account -> API Keys -> New Key, only needs the
# pinFileToIPFS permission). Leave blank to keep files stored only in the
# app's own database (no IPFS/on-chain file link).
PINATA_JWT=
# Optional: override the gateway used to build viewable file links.
# Defaults to https://gateway.pinata.cloud/ipfs
IPFS_GATEWAY_URL=
