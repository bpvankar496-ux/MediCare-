# Copy to server/.env and fill in your own values. Never commit the real
# .env file (it's already in .gitignore).

MONGODB_URI=
JWT_SECRET=
PORT=4000
CLIENT_ORIGIN=
RECEPTION_EMAIL=
RECEPTION_PASSWORD=
RECEPTION_NAME=
GOOGLE_CLIENT_ID=
GROQ_API_KEY=
ANTHROPIC_MODEL=
# --- Blockchain (Ethereum Sepolia testnet) ---
# Leave these blank to run the app without blockchain features - everything
# else keeps working. Fill them in after deploying the contract in /blockchain
# (see blockchain/README.md) to enable real on-chain anchoring/verification
# of health records.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=
