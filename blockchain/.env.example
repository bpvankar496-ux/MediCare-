# Copy to blockchain/.env and fill in your own values. Never commit the real
# .env (already covered by .gitignore).

# Your Sepolia RPC URL from Alchemy/Infura, e.g.:
# https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>
SEPOLIA_RPC_URL=

# Private key of the wallet that will deploy the contract and act as the
# backend's anchoring wallet. Use a throwaway/dev wallet funded ONLY with
# free Sepolia testnet ETH - never a wallet holding real funds. Must start
# with 0x.
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=