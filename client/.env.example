# Copy this file to client/.env - nothing here is required for local dev
# (sensible defaults are baked in, see src/lib/db.ts).

# Override the API base URL. Leave unset for local dev (defaults to
# http://localhost:4000) and for the single-process production deploy
# (defaults to '' - same origin as the page).
VITE_API_URL=

# Needed only if you want the "Sign in with Google" button to work.
# Must match GOOGLE_CLIENT_ID in server/.env.
VITE_GOOGLE_CLIENT_ID=
